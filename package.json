{
  "name": "@nds-stack/bun-html",
  "version": "0.1.0-alpha.11",
  "description": "Zero-dependency Bun-native HTML template engine with mustache-like syntax, auto-escape, async partials, and helpers",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "bun-html": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build:cli": "bun build ./src/cli.ts --outdir ./dist --target bun --format esm && bun run fix:shebang",
    "fix:shebang": "bun -e \"const fs=require('fs');const c=fs.readFileSync('dist/cli.js','utf8');fs.writeFileSync('dist/cli.js','#!/usr/bin/env bun\\n'+c.replace('// @bun\\n',''))\"",
    "build": "bun run clean && bun build ./src/index.ts --outdir ./dist --target bun --format esm && bun run build:cli && tsc -p tsconfig.build.json",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "bench": "bun bench/html.bench.ts"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/mustache": "^4.2.6",
    "@types/nunjucks": "^3.2.6",
    "bun-types": "latest",
    "ejs": "^3.1.10",
    "eta": "^4.6.0",
    "handlebars": "^4.7.8",
    "mustache": "^4.2.0",
    "nunjucks": "^3.2.4",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nds-stack/bun-html"
  },
  "keywords": [
    "bun",
    "html",
    "template",
    "mustache",
    "template-engine",
    "ssr"
  ],
  "license": "MIT"
}
